5,\n    \"build_cmd\": 10, \"test_cmd\": 12, \"docker_cmd\": 8, \"ssh_cmd\": 5,\n    \"active_hour\": 8,\n}\nassert WEIGHTS == expected_weights\nprint(\"  Scoring weights ✓\")\n\n# 6. MAX_SCORE\nassert MAX_SCORE == 600\nprint(\"  MAX_SCORE = 600 ✓\")\n\n# 7. Grade colors\nassert GRADE_COLORS == {\"S\": \"gold1\", \"A\": \"green\", \"B\": \"cyan\", \"C\": \"yellow\", \"D\": \"orange1\", \"F\": \"red\"}\nprint(\"  Grade colors ✓\")\n\n# 8. Test grade boundaries\ntest_cases = [(600, \"S\"), (500, \"S\"), (499, \"A\"), (350, \"A\"), (349, \"B\"), (200, \"B\"), (199, \"C\"), (100, \"C\"), (99, \"D\"), (50, \"D\"), (49, \"F\"), (0, \"F\")]\nfor score_val, expected_grade in test_cases:\n    m = DayMetrics()\n    # Set enough git_commits to reach score_val (each = 25 pts)\n    # We can't directly set score, so let's test the grade function directly\n    pass\n\n# Test grade function by adjusting commit count\nfor target_score, expected_grade in [(600, \"S\"), (350, \"A\"), (200, \"B\"), (100, \"C\"), (50, \"D\"), (0, \"F\")]:\n    m = DayMetrics()\n    m.git_commits = target_score // 25\n    remaining = target_score % 25\n    m.windows_opened = remaining // 5\n    # May not hit exact score but test grade boundaries\n    if m.score() >= 500:\n        assert m.grade() in (\"S\",), f\"score={m.score()} should be S, got {m.grade()}\"\n    elif m.score() >= 350:\n        assert m.grade() == \"A\"\n    elif m.score() >= 200:\n        assert m.grade() == \"B\"\n    elif m.score() >= 100:\n        assert m.grade() == \"C\"\n    elif m.score() >= 50:\n        assert m.grade() == \"D\"\n    else:\n        assert m.grade() == \"F\"\nprint(\"  Grade boundaries ✓\")\n\n# 9. Render functions exist and return correct types\nm = DayMetrics()\nm.nvim_opens = 1\nm.nvim_files = {'test.py'}\nm.total_commands = 10\nscore_result = render_score(m)\nmetrics_result = render_metrics(m)\nheatmap_result = render_heatmap(m)\ntimeline_result = render_timeline(m)\nempty_timeline = render_timeline(DayMetrics())\n\nfrom rich.text import Text\nfrom rich.table import Table\nassert isinstance(score_result, Text)\nassert isinstance(metrics_result, Table)\nassert isinstance(heatmap_result, Text)\nassert isinstance(timeline_result, Text)\nassert \"No events recorded yet.\" in empty_timeline.plain\nprint(\"  Render functions ✓\")\n\n# 10. Bindings\nfrom textual.binding import Binding\napp = ProductivityApp()\nbinding_keys = {b.key for b in app.BINDINGS}\nassert \"q\" in binding_keys\nassert \"r\" in binding_keys\nassert \"left\" in binding_keys\nassert \"right\" in binding_keys\nassert \"h\" in binding_keys\nassert \"l\" in binding_keys\nprint(\"  Key bindings ✓\")\n\n# 11. Check CSS contains required selectors\ncss = ProductivityApp.CSS\nfor selector in [\"#top-row\", \"#score-panel\", \"#metrics-panel\", \"#heatmap-panel\", \"#timeline-panel\", \"#tl-content\"]:\n    assert selector in css, f\"Missing CSS for {selector}\"\nprint(\"  CSS selectors ✓\")\n\n# 12. Timeline emoji labels match spec\ntoday = datetime.date.today()\nbase_ts = int(time.mktime(datetime.datetime.combine(today, datetime.time.min).timetuple())) + 100\n\nm = DayMetrics()\nm.timeline = [\n    (base_ts, \"📝 nvim\", \"file.py\"),\n    (base_ts+1, \"🔀 lazygit\", \"\"),\n    (base_ts+2, \"🤖 claude\", \"\"),\n    (base_ts+3, \"✅ commit\", \"\"),\n    (base_ts+4, \"⬆  push\", \"\"),\n    (base_ts+5, \"🔨 build\", \"make\"),\n    (base_ts+6, \"🧪 test\", \"pytest\"),\n    (base_ts+7, \"🖥  window\", \"main:code\"),\n    (base_ts+8, \"🚀 session\", \"main:dev\"),\n]\ntl = render_timeline(m)\nassert \"📝 nvim\" in tl.plain\nassert \"🔀 lazygit\" in tl.plain\nassert \"🤖 claude\" in tl.plain\nassert \"✅ commit\" in tl.plain\nassert \"⬆  push\" in tl.plain\nassert \"🔨 build\" in tl.plain\nassert \"🧪 test\" in tl.plain\nassert \"🖥  window\" in tl.plain\nassert \"🚀 session\" in tl.plain\nprint(\"  Timeline emoji labels ✓\")\n\nprint(\"\\n=== ALL SPEC COMPLIANCE CHECKS PASSED ✅ ===\")\nPYEOF","description":"Comprehensive spec compliance verification","timeout":15000},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":306,"cache_read_input_tokens":49162,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":306},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"65288ace-518d-4c9f-acbc-5e975c759dfa","uuid":"b7b6d6a9-68cc-4837-b1d1-b9d895c9fd0f"}
