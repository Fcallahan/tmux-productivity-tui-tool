hould be a Text object with score info\n        assert score_panel.renderable is not None\n        \n        # Check metrics panel\n        metrics_panel = app.query_one(\"#metrics-panel\", Static)\n        assert metrics_panel.renderable is not None\n        \n        # Check heatmap panel\n        heatmap_panel = app.query_one(\"#heatmap-panel\", Static)\n        assert heatmap_panel.renderable is not None\n        \n        # Check timeline\n        tl_content = app.query_one(\"#tl-content\", Static)\n        assert tl_content.renderable is not None\n        \n        # Verify the parsed data\n        m = parse_log(today)\n        assert m.total_commands == 15, f\"Expected 15, got {m.total_commands}\"\n        assert m.nvim_opens == 2\n        assert m.nvim_files == {'src/main.py', 'tests/test_api.py'}\n        assert m.lazygit_opens == 1\n        assert m.claude_opens == 1\n        assert m.git_commits == 1\n        assert m.git_pushes == 1\n        assert m.test_cmds == 2  # dotnet test + pytest\n        assert m.build_cmds == 3  # dotnet build + cargo build + npm run\n        assert m.docker_cmds == 1\n        assert m.ssh_cmds == 1\n        assert m.windows_opened == 1\n        assert m.sessions_opened == 1\n        \n        # Verify score\n        expected = (\n            1*5 + 1*3 +  # window + session\n            2*10 + 2*3 +  # nvim opens + files\n            1*15 + 1*12 +  # lazygit + claude\n            1*25 + 1*15 +  # commit + push\n            3*10 + 2*12 +  # builds + tests\n            1*8 + 1*5 +   # docker + ssh\n            m.active_hours * 8\n        )\n        assert m.score() == expected, f\"Score mismatch: {m.score()} != {expected}\"\n        \n        # Verify grade\n        print(f\"Score: {m.score()}, Grade: {m.grade()}\")\n        \n        # Verify prev/next day with data\n        await pilot.press(\"left\")\n        # Yesterday should have no data\n        m2 = parse_log(app._date)\n        assert m2.total_commands == 0\n        assert m2.score() == 0\n        \n        await pilot.press(\"right\")  # back to today\n        \n        print(\"FULL INTEGRATION TEST PASSED\")\n\nasyncio.run(test_with_data())\n\n# Clean up - empty the events log\nwith open(log_path, 'w') as f:\n    pass\nPYEOF","description":"Full integration test with synthetic data","timeout":30000},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":9596,"cache_read_input_tokens":29962,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9596},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"65288ace-518d-4c9f-acbc-5e975c759dfa","uuid":"ea222266-fbe0-4108-8b1d-c4a0aaca5c79"}
