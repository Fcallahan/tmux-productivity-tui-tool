ssed. Score={s}, Grade={m.grade()}')\n\n# Test render functions don't crash\ntext_score = render_score(m)\ntable_metrics = render_metrics(m)\ntext_heatmap = render_heatmap(m)\ntext_timeline = render_timeline(m)\nprint('✓ All render functions execute without error')\n\n# Test grade thresholds\nassert m.grade() == 'C', f'Expected C grade for score {s}, got {m.grade()}'\nprint(f'✓ Grade={m.grade()} correct for score={s}')\n\n# Verify timeline is sorted (ascending by ts)\nassert len(m.timeline) > 0\nfor i in range(len(m.timeline) - 1):\n    assert m.timeline[i][0] <= m.timeline[i+1][0], 'Timeline not sorted'\nprint(f'✓ Timeline sorted ascending ({len(m.timeline)} events)')\n\"","description":"Comprehensive parse_log and render function test"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":540,"cache_read_input_tokens":29071,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":540},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"9c66998b-2051-43d2-bb8b-b111dff93325","uuid":"f4ace8e8-4c36-4076-ac25-9ad3143b534b"}
