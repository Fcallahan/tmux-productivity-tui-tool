{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ABqH6AY8CcNMRCoPbYdhR3","type":"tool_result","content":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"tmux-productivity — Terminal productivity dashboard.\"\"\"\n     3\t\n     4\timport datetime\n     5\timport os\n     6\timport re\n     7\timport time\n     8\tfrom collections import defaultdict\n     9\tfrom dataclasses import dataclass, field\n    10\tfrom pathlib import Path\n    11\tfrom typing import Dict, List, Set, Tuple\n    12\t\n    13\tfrom textual.app import App, ComposeResult\n    14\tfrom textual.binding import Binding\n    15\tfrom textual.containers import Horizontal, ScrollableContainer\n    16\tfrom textual.widgets import Footer, Header, Static\n    17\t\n    18\tfrom rich.table import Table\n    19\tfrom rich.text import Text\n    20\tfrom rich import box\n    21\t\n    22\t# ── Scoring ──────────────────────────────────────────────────────────────────\n    23\t\n    24\tWEIGHTS = {\n    25\t    \"new_window\":  5,\n    26\t    \"new_session\": 3,\n    27\t    \"nvim_open\":   10,\n    28\t    \"nvim_file\":   3,\n    29\t    \"lazygit\":     15,\n    30\t    \"claude\":      12,\n    31\t    \"git_commit\":  25,\n    32\t    \"git_push\":    15,\n    33\t    \"build_cmd\":   10,\n    34\t    \"test_cmd\":    12,\n    35\t    \"docker_cmd\":  8,\n    36\t    \"ssh_cmd\":     5,\n    37\t    \"active_hour\": 8,\n    38\t}\n    39\t\n    40\tGRADE_THRESHOLDS = [(500, \"S\"), (350, \"A\"), (200, \"B\"), (100, \"C\"), (50, \"D\")]\n    41\tMAX_SCORE = 600\n    42\t\n    43\tGRADE_COLORS = {\n    44\t    \"S\": \"gold1\",\n    45\t    \"A\": \"green\",\n    46\t    \"B\": \"cyan\",\n    47\t    \"C\": \"yellow\",\n    48\t    \"D\": \"orange1\",\n    49\t    \"F\": \"red\",\n    50\t}\n    51\t\n    52\tLOG_FILE = Path.home() / \".tmux-productivity\" / \"events.log\"\n    53\t\n    54\t# ── Data Model ───────────────────────────────────────────────────────────────\n    55\t\n    56\t@dataclass\n    57\tclass DayMetrics:\n    58\t    windows_opened: int = 0\n    59\t    sessions_opened: int = 0\n    60\t    nvim_opens: int = 0\n    61\t    nvim_files: Set[str] = field(default_factory=set)\n    62\t    lazygit_opens: int = 0\n    63\t    claude_opens: int = 0\n    64\t    git_commits: int = 0\n    65\t    git_pushes: int = 0\n    66\t    build_cmds: int = 0\n    67\t    test_cmds: int = 0\n    68\t    docker_cmds: int = 0\n    69\t    ssh_cmds: int = 0\n    70\t    total_commands: int = 0\n    71\t    commands_by_hour: Dict[int, int] = field(default_factory=lambda: defaultdict(int))\n    72\t    timeline: List[Tuple[int, str, str]] = field(default_factory=list)\n    73\t\n    74\t    @property\n    75\t    def active_hours(self) -> int:\n    76\t        return sum(1 for h in self.commands_by_hour.values() if h >= 5)\n    77\t\n    78\t    def score(self) -> int:\n    79\t        return (\n    80\t            self.windows_opened * WEIGHTS[\"new_window\"]\n    81\t            + self.sessions_opened * WEIGHTS[\"new_session\"]\n    82\t            + self.nvim_opens * WEIGHTS[\"nvim_open\"]\n    83\t            + len(self.nvim_files) * WEIGHTS[\"nvim_file\"]\n    84\t            + self.lazygit_opens * WEIGHTS[\"lazygit\"]\n    85\t            + self.claude_opens * WEIGHTS[\"claude\"]\n    86\t            + self.git_commits * WEIGHTS[\"git_commit\"]\n    87\t            + self.git_pushes * WEIGHTS[\"git_push\"]\n    88\t            + self.build_cmds * WEIGHTS[\"build_cmd\"]\n    89\t            + self.test_cmds * WEIGHTS[\"test_cmd\"]\n    90\t            + self.docker_cmds * WEIGHTS[\"docker_cmd\"]\n    91\t            + self.ssh_cmds * WEIGHTS[\"ssh_cmd\"]\n    92\t            + self.active_hours * WEIGHTS[\"active_hour\"]\n    93\t        )\n    94\t\n    95\t    def grade(self) -> str:\n    96\t        s = self.score()\n    97\t        for threshold, letter in GRADE_THRESHOLDS:\n    98\t            if s >= threshold:\n    99\t                return letter\n   100\t        return \"F\"\n   101\t\n   102\t\n   103\t# ── Log Parsing ──────────────────────────────────────────────────────────────\n   104\t\n   105\tdef parse_log(date: datetime.date) -> DayMetrics:\n   106\t    m = DayMetrics()\n   107\t\n   108\t    start_ts = int(time.mktime(datetime.datetime.combine(date, datetime.time.min).timetuple()))\n   109\t    end_ts = int(time.mktime(datetime.datetime.combine(date, datetime.time.max).timetuple()))\n   110\t\n   111\t    if not LOG_FILE.exists():\n   112\t        return m\n   113\t\n   114\t    with open(LOG_FILE, \"r\") as f:\n   115\t        for line in f:\n   116\t            line = line.rstrip(\"\\n\")\n   117\t            parts = line.split(\"\\t\")\n   118\t            if len(parts) < 4:\n   119\t                continue\n   120\t\n   121\t            try:\n   122\t                ts = int(parts[0])\n   123\t            except ValueError:\n   124\t                continue\n   125\t\n   126\t            if ts < start_ts or ts > end_ts:\n   127\t                continue\n   128\t\n   129\t            kind = parts[1]\n   130\t            data = parts[2]\n   131\t            window = parts[3]\n   132\t\n   133\t            if kind == \"event\":\n   134\t                if data == \"new-window\":\n   135\t                    m.windows_opened += 1\n   136\t                    m.timeline.append((ts, \"🖥  window\", window))\n   137\t                elif data == \"new-session\":\n   138\t                    m.sessions_opened += 1\n   139\t                    m.timeline.append((ts, \"🚀 session\", window))\n   140\t\n   141\t            elif kind == \"cmd\":\n   142\t                m.total_commands += 1\n   143\t                hour = datetime.datetime.fromtimestamp(ts).hour\n   144\t                m.commands_by_hour[hour] += 1\n   145\t                cmd = data.strip()\n   146\t\n   147\t                if re.match(r'^n?vi?m?\\b', cmd):\n   148\t                    m.nvim_opens += 1\n   149\t                    # extract non-flag args as files\n   150\t                    args = cmd.split()[1:]\n   151\t                    for arg in args:\n   152\t                        if not arg.startswith(\"-\"):\n   153\t                            m.nvim_files.add(arg)\n   154\t                    detail = \" \".join(a for a in args if not a.startswith(\"-\"))\n   155\t                    m.timeline.append((ts, \"📝 nvim\", detail))\n   156\t\n   157\t                elif re.match(r'^lazygit\\b', cmd):\n   158\t                    m.lazygit_opens += 1\n   159\t                    m.timeline.append((ts, \"🔀 lazygit\", \"\"))\n   160\t\n   161\t                elif re.match(r'^claude\\b', cmd):\n   162\t                    m.claude_opens += 1\n   163\t                    m.timeline.append((ts, \"🤖 claude\", \"\"))\n   164\t\n   165\t                elif re.match(r'^git\\s+commit', cmd):\n   166\t                    m.git_commits += 1\n   167\t                    m.timeline.append((ts, \"✅ commit\", \"\"))\n   168\t\n   169\t                elif re.match(r'^git\\s+push', cmd):\n   170\t                    m.git_pushes += 1\n   171\t                    m.timeline.append((ts, \"⬆  push\", \"\"))\n   172\t\n   173\t                elif re.match(r'^(dotnet test|cargo test|npm test|pytest\\b|go test|jest\\b)', cmd):\n   174\t                    m.test_cmds += 1\n   175\t                    m.timeline.append((ts, \"🧪 test\", cmd))\n   176\t\n   177\t                elif re.match(r'^(dotnet (build|run|publish)|cargo (build|run|check)|npm (run|build)|make\\b|go (build|run)|gradle\\b)', cmd):\n   178\t                    m.build_cmds += 1\n   179\t                    m.timeline.append((ts, \"🔨 build\", cmd))\n   180\t\n   181\t                elif re.match(r'^docker\\b', cmd):\n   182\t                    m.docker_cmds += 1\n   183\t\n   184\t                elif re.match(r'^ssh\\b', cmd):\n   185\t                    m.ssh_cmds += 1\n   186\t\n   187\t    m.timeline.sort(key=lambda x: x[0])\n   188\t    return m\n   189\t\n   190\t\n   191\t# ── Render Functions ─────────────────────────────────────────────────────────\n   192\t\n   193\tdef render_score(m: DayMetrics) -> Text:\n   194\t    s = m.score()\n   195\t    g = m.grade()\n   196\t    color = GRADE_COLORS.get(g, \"white\")\n   197\t\n   198\t    pct = min(s / MAX_SCORE, 1.0)\n   199\t    filled = int(pct * 20)\n   200\t    bar = \"█\" * filled + \"░\" * (20 - filled)\n   201\t\n   202\t    t = Text()\n   203\t    t.append(\"\\n\")\n   204\t    t.append(f\"  {s}\\n\", style=\"bold white\")\n   205\t    t.append(f\"  Grade: \", style=\"dim\")\n   206\t    t.append(f\"{g}\\n\", style=f\"bold {color}\")\n   207\t    t.append(f\"\\n  {bar}\\n\", style=\"cyan\")\n   208\t    t.append(f\"  {int(pct*100)}% of {MAX_SCORE}\\n\\n\", style=\"dim\")\n   209\t    t.append(f\"  ⌨  {m.total_commands} cmds\\n\", style=\"white\")\n   210\t    t.append(f\"  ⏱  {m.active_hours} active hrs\\n\", style=\"white\")\n   211\t    t.append(f\"  📂 {len(m.nvim_files)} files\\n\", style=\"white\")\n   212\t    return t\n   213\t\n   214\t\n   215\tdef render_metrics(m: DayMetrics) -> Table:\n   216\t    table = Table(box=box.SIMPLE, expand=True, padding=(0, 1))\n   217\t    table.add_column(\"Activity\", style=\"bold white\", ratio=3)\n   218\t    table.add_column(\"Count\", justify=\"right\", style=\"cyan\", ratio=1)\n   219\t    table.add_column(\"Points\", justify=\"right\", style=\"green\", ratio=1)\n   220\t\n   221\t    rows = [\n   222\t        (\"Terminals\",    m.windows_opened + m.sessions_opened,\n   223\t         m.windows_opened * WEIGHTS[\"new_window\"] + m.sessions_opened * WEIGHTS[\"new_session\"]),\n   224\t        (\"Nvim opens\",   m.nvim_opens,     m.nvim_opens * WEIGHTS[\"nvim_open\"]),\n   225\t        (\"Unique files\", len(m.nvim_files), len(m.nvim_files) * WEIGHTS[\"nvim_file\"]),\n   226\t        (\"Lazygit\",      m.lazygit_opens,  m.lazygit_opens * WEIGHTS[\"lazygit\"]),\n   227\t        (\"Claude\",       m.claude_opens,   m.claude_opens * WEIGHTS[\"claude\"]),\n   228\t        (\"Commits\",      m.git_commits,    m.git_commits * WEIGHTS[\"git_commit\"]),\n   229\t        (\"Pushes\",       m.git_pushes,     m.git_pushes * WEIGHTS[\"git_push\"]),\n   230\t        (\"Builds\",       m.build_cmds,     m.build_cmds * WEIGHTS[\"build_cmd\"]),\n   231\t        (\"Tests\",        m.test_cmds,      m.test_cmds * WEIGHTS[\"test_cmd\"]),\n   232\t        (\"Docker\",       m.docker_cmds,    m.docker_cmds * WEIGHTS[\"docker_cmd\"]),\n   233\t        (\"SSH\",          m.ssh_cmds,       m.ssh_cmds * WEIGHTS[\"ssh_cmd\"]),\n   234\t        (\"Active hours\", m.active_hours,   m.active_hours * WEIGHTS[\"active_hour\"]),\n   235\t    ]\n   236\t\n   237\t    for name, count, pts in rows:\n   238\t        c = \"—\" if count == 0 else str(count)\n   239\t        p = \"—\" if pts == 0 else f\"+{pts}\"\n   240\t        table.add_row(name, c, p)\n   241\t\n   242\t    return table\n   243\t\n   244\t\n   245\tdef render_heatmap(m: DayMetrics) -> Text:\n   246\t    blocks = \" ░▒▓█\"\n   247\t    colors = [\"dim\", \"dim cyan\", \"cyan\", \"bold cyan\", \"bold white\"]\n   248\t\n   249\t    hours = list(range(6, 23))\n   250\t    counts = [m.commands_by_hour.get(h, 0) for h in hours]\n   251\t    peak = max(counts) if max(counts) > 0 else 1\n   252\t\n   253\t    t = Text()\n   254\t    t.append(\"  \")\n   255\t    for h in hours:\n   256\t        t.append(f\"{h:02d} \", style=\"dim\")\n   257\t    t.append(\"\\n  \")\n   258\t    for c in counts:\n   259\t        level = min(int(c / peak * 4), 4) if c > 0 else 0\n   260\t        t.append(f\" {blocks[level]} \", style=colors[level])\n   261\t    return t\n   262\t\n   263\t\n   264\tdef render_timeline(m: DayMetrics) -> Text:\n   265\t    if not m.timeline:\n   266\t        return Text(\"  No events recorded yet.\", style=\"dim italic\")\n   267\t\n   268\t    t = Text()\n   269\t    for ts, label, detail in reversed(m.timeline):\n   270\t        time_str = datetime.datetime.fromtimestamp(ts).strftime(\"%H:%M:%S\")\n   271\t        detail_trunc = (detail[:50] + \"…\") if len(detail) > 50 else detail\n   272\t        t.append(f\"  {time_str}  \", style=\"dim\")\n   273\t        t.append(f\"{label:<14s}  \", style=\"white\")\n   274\t        t.append(f\"{detail_trunc}\\n\", style=\"dim cyan\")\n   275\t    return t\n   276\t\n   277\t\n   278\t# ── TUI Widgets ──────────────────────────────────────────────────────────────\n   279\t\n   280\tclass TimelinePanel(ScrollableContainer):\n   281\t    def compose(self) -> ComposeResult:\n   282\t        yield Static(\"\", id=\"tl-content\")\n   283\t\n   284\t    def refresh_timeline(self, m: DayMetrics) -> None:\n   285\t        self.query_one(\"#tl-content\", Static).update(render_timeline(m))\n   286\t        self.scroll_home(animate=False)\n   287\t\n   288\t\n   289\t# ── Main App ─────────────────────────────────────────────────────────────────\n   290\t\n   291\tclass ProductivityApp(App):\n   292\t    CSS = \"\"\"\n   293\t    Screen { background: #0d0d0d; }\n   294\t    Header { background: #1a1a2e; }\n   295\t    #top-row { height: 16; margin: 0 1; }\n   296\t    #score-panel { width: 26; border: round #2a2a3e; padding: 0 1; background: #111118; }\n   297\t    #metrics-panel { width: 1fr; border: round #2a2a3e; padding: 0 1; background: #111118; margin-left: 1; }\n   298\t    #heatmap-panel { height: 5; border: round #2a2a3e; padding: 1 1; background: #111118; margin: 1 1 0 1; }\n   299\t    #timeline-panel { height: 1fr; border: round #2a2a3e; background: #0d0d0d; margin: 1; overflow-y: scroll; }\n   300\t    #tl-content { padding: 1 0; }\n   301\t    \"\"\"\n   302\t\n   303\t    BINDINGS = [\n   304\t        Binding(\"q\",     \"quit\",     \"Quit\"),\n   305\t        Binding(\"r\",     \"refresh\",  \"Refresh\"),\n   306\t        Binding(\"left\",  \"prev_day\", \"Prev Day\"),\n   307\t        Binding(\"right\", \"next_day\", \"Next Day\"),\n   308\t        Binding(\"h\",     \"prev_day\", show=False),\n   309\t        Binding(\"l\",     \"next_day\", show=False),\n   310\t    ]\n   311\t\n   312\t    def __init__(self):\n   313\t        super().__init__()\n   314\t        self._date = datetime.date.today()\n   315\t\n   316\t    def compose(self) -> ComposeResult:\n   317\t        yield Header(show_clock=True)\n   318\t        with Horizontal(id=\"top-row\"):\n   319\t            yield Static(\"\", id=\"score-panel\")\n   320\t            yield Static(\"\", id=\"metrics-panel\")\n   321\t        yield Static(\"\", id=\"heatmap-panel\")\n   322\t        yield TimelinePanel(id=\"timeline-panel\")\n   323\t        yield Footer()\n   324\t\n   325\t    def on_mount(self) -> None:\n   326\t        self._load()\n   327\t        self.set_interval(30, self._load)\n   328\t\n   329\t    def _load(self) -> None:\n   330\t        m = parse_log(self._date)\n   331\t\n   332\t        self.title = \"tmux-productivity\"\n   333\t        self.sub_title = f\"{self._date.isoformat()}  •  auto-refresh\"\n   334\t\n   335\t        self.query_one(\"#score-panel\", Static).update(render_score(m))\n   336\t        self.query_one(\"#metrics-panel\", Static).update(render_metrics(m))\n   337\t        self.query_one(\"#heatmap-panel\", Static).update(render_heatmap(m))\n   338\t        self.query_one(\"#timeline-panel\", TimelinePanel).refresh_timeline(m)\n   339\t\n   340\t    def action_refresh(self) -> None:\n   341\t        self._load()\n   342\t\n   343\t    def action_prev_day(self) -> None:\n   344\t        self._date -= datetime.timedelta(days=1)\n   345\t        self._load()\n   346\t\n   347\t    def action_next_day(self) -> None:\n   348\t        if self._date < datetime.date.today():\n   349\t            self._date += datetime.timedelta(days=1)\n   350\t            self._load()\n   351\t\n   352\t\n   353\tif __name__ == \"__main__\":\n   354\t    app = ProductivityApp()\n   355\t    app.run()","is_error":false}]},"parent_tool_use_id":null,"session_id":"9c66998b-2051-43d2-bb8b-b111dff93325","uuid":"4992c4dc-b34b-4320-b6e3-28269bbda98b","timestamp":"2026-04-11T04:08:51.882Z","tool_use_result":{"stdout":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"tmux-productivity — Terminal productivity dashboard.\"\"\"\n     3\t\n     4\timport datetime\n     5\timport os\n     6\timport re\n     7\timport time\n     8\tfrom collections import defaultdict\n     9\tfrom dataclasses import dataclass, field\n    10\tfrom pathlib import Path\n    11\tfrom typing import Dict, List, Set, Tuple\n    12\t\n    13\tfrom textual.app import App, ComposeResult\n    14\tfrom textual.binding import Binding\n    15\tfrom textual.containers import Horizontal, ScrollableContainer\n    16\tfrom textual.widgets import Footer, Header, Static\n    17\t\n    18\tfrom rich.table import Table\n    19\tfrom rich.text import Text\n    20\tfrom rich import box\n    21\t\n    22\t# ── Scoring ──────────────────────────────────────────────────────────────────\n    23\t\n    24\tWEIGHTS = {\n    25\t    \"new_window\":  5,\n    26\t    \"new_session\": 3,\n    27\t    \"nvim_open\":   10,\n    28\t    \"nvim_file\":   3,\n    29\t    \"lazygit\":     15,\n    30\t    \"claude\":      12,\n    31\t    \"git_commit\":  25,\n    32\t    \"git_push\":    15,\n    33\t    \"build_cmd\":   10,\n    34\t    \"test_cmd\":    12,\n    35\t    \"docker_cmd\":  8,\n    36\t    \"ssh_cmd\":     5,\n    37\t    \"active_hour\": 8,\n    38\t}\n    39\t\n    40\tGRADE_THRESHOLDS = [(500, \"S\"), (350, \"A\"), (200, \"B\"), (100, \"C\"), (50, \"D\")]\n    41\tMAX_SCORE = 600\n    42\t\n    43\tGRADE_COLORS = {\n    44\t    \"S\": \"gold1\",\n    45\t    \"A\": \"green\",\n    46\t    \"B\": \"cyan\",\n    47\t    \"C\": \"yellow\",\n    48\t    \"D\": \"orange1\",\n    49\t    \"F\": \"red\",\n    50\t}\n    51\t\n    52\tLOG_FILE = Path.home() / \".tmux-productivity\" / \"events.log\"\n    53\t\n    54\t# ── Data Model ───────────────────────────────────────────────────────────────\n    55\t\n    56\t@dataclass\n    57\tclass DayMetrics:\n    58\t    windows_opened: int = 0\n    59\t    sessions_opened: int = 0\n    60\t    nvim_opens: int = 0\n    61\t    nvim_files: Set[str] = field(default_factory=set)\n    62\t    lazygit_opens: int = 0\n    63\t    claude_opens: int = 0\n    64\t    git_commits: int = 0\n    65\t    git_pushes: int = 0\n    66\t    build_cmds: int = 0\n    67\t    test_cmds: int = 0\n    68\t    docker_cmds: int = 0\n    69\t    ssh_cmds: int = 0\n    70\t    total_commands: int = 0\n    71\t    commands_by_hour: Dict[int, int] = field(default_factory=lambda: defaultdict(int))\n    72\t    timeline: List[Tuple[int, str, str]] = field(default_factory=list)\n    73\t\n    74\t    @property\n    75\t    def active_hours(self) -> int:\n    76\t        return sum(1 for h in self.commands_by_hour.values() if h >= 5)\n    77\t\n    78\t    def score(self) -> int:\n    79\t        return (\n    80\t            self.windows_opened * WEIGHTS[\"new_window\"]\n    81\t            + self.sessions_opened * WEIGHTS[\"new_session\"]\n    82\t            + self.nvim_opens * WEIGHTS[\"nvim_open\"]\n    83\t            + len(self.nvim_files) * WEIGHTS[\"nvim_file\"]\n    84\t            + self.lazygit_opens * WEIGHTS[\"lazygit\"]\n    85\t            + self.claude_opens * WEIGHTS[\"claude\"]\n    86\t            + self.git_commits * WEIGHTS[\"git_commit\"]\n    87\t            + self.git_pushes * WEIGHTS[\"git_push\"]\n    88\t            + self.build_cmds * WEIGHTS[\"build_cmd\"]\n    89\t            + self.test_cmds * WEIGHTS[\"test_cmd\"]\n    90\t            + self.docker_cmds * WEIGHTS[\"docker_cmd\"]\n    91\t            + self.ssh_cmds * WEIGHTS[\"ssh_cmd\"]\n    92\t            + self.active_hours * WEIGHTS[\"active_hour\"]\n    93\t        )\n    94\t\n    95\t    def grade(self) -> str:\n    96\t        s = self.score()\n    97\t        for threshold, letter in GRADE_THRESHOLDS:\n    98\t            if s >= threshold:\n    99\t                return letter\n   100\t        return \"F\"\n   101\t\n   102\t\n   103\t# ── Log Parsing ──────────────────────────────────────────────────────────────\n   104\t\n   105\tdef parse_log(date: datetime.date) -> DayMetrics:\n   106\t    m = DayMetrics()\n   107\t\n   108\t    start_ts = int(time.mktime(datetime.datetime.combine(date, datetime.time.min).timetuple()))\n   109\t    end_ts = int(time.mktime(datetime.datetime.combine(date, datetime.time.max).timetuple()))\n   110\t\n   111\t    if not LOG_FILE.exists():\n   112\t        return m\n   113\t\n   114\t    with open(LOG_FILE, \"r\") as f:\n   115\t        for line in f:\n   116\t            line = line.rstrip(\"\\n\")\n   117\t            parts = line.split(\"\\t\")\n   118\t            if len(parts) < 4:\n   119\t                continue\n   120\t\n   121\t            try:\n   122\t                ts = int(parts[0])\n   123\t            except ValueError:\n   124\t                continue\n   125\t\n   126\t            if ts < start_ts or ts > end_ts:\n   127\t                continue\n   128\t\n   129\t            kind = parts[1]\n   130\t            data = parts[2]\n   131\t            window = parts[3]\n   132\t\n   133\t            if kind == \"event\":\n   134\t                if data == \"new-window\":\n   135\t                    m.windows_opened += 1\n   136\t                    m.timeline.append((ts, \"🖥  window\", window))\n   137\t                elif data == \"new-session\":\n   138\t                    m.sessions_opened += 1\n   139\t                    m.timeline.append((ts, \"🚀 session\", window))\n   140\t\n   141\t            elif kind == \"cmd\":\n   142\t                m.total_commands += 1\n   143\t                hour = datetime.datetime.fromtimestamp(ts).hour\n   144\t                m.commands_by_hour[hour] += 1\n   145\t                cmd = data.strip()\n   146\t\n   147\t                if re.match(r'^n?vi?m?\\b', cmd):\n   148\t                    m.nvim_opens += 1\n   149\t                    # extract non-flag args as files\n   150\t                    args = cmd.split()[1:]\n   151\t                    for arg in args:\n   152\t                        if not arg.startswith(\"-\"):\n   153\t                            m.nvim_files.add(arg)\n   154\t                    detail = \" \".join(a for a in args if not a.startswith(\"-\"))\n   155\t                    m.timeline.append((ts, \"📝 nvim\", detail))\n   156\t\n   157\t                elif re.match(r'^lazygit\\b', cmd):\n   158\t                    m.lazygit_opens += 1\n   159\t                    m.timeline.append((ts, \"🔀 lazygit\", \"\"))\n   160\t\n   161\t                elif re.match(r'^claude\\b', cmd):\n   162\t                    m.claude_opens += 1\n   163\t                    m.timeline.append((ts, \"🤖 claude\", \"\"))\n   164\t\n   165\t                elif re.match(r'^git\\s+commit', cmd):\n   166\t                    m.git_commits += 1\n   167\t                    m.timeline.append((ts, \"✅ commit\", \"\"))\n   168\t\n   169\t                elif re.match(r'^git\\s+push', cmd):\n   170\t                    m.git_pushes += 1\n   171\t                    m.timeline.append((ts, \"⬆  push\", \"\"))\n   172\t\n   173\t                elif re.match(r'^(dotnet test|cargo test|npm test|pytest\\b|go test|jest\\b)', cmd):\n   174\t                    m.test_cmds += 1\n   175\t                    m.timeline.append((ts, \"🧪 test\", cmd))\n   176\t\n   177\t                elif re.match(r'^(dotnet (build|run|publish)|cargo (build|run|check)|npm (run|build)|make\\b|go (build|run)|gradle\\b)', cmd):\n   178\t                    m.build_cmds += 1\n   179\t                    m.timeline.append((ts, \"🔨 build\", cmd))\n   180\t\n   181\t                elif re.match(r'^docker\\b', cmd):\n   182\t                    m.docker_cmds += 1\n   183\t\n   184\t                elif re.match(r'^ssh\\b', cmd):\n   185\t                    m.ssh_cmds += 1\n   186\t\n   187\t    m.timeline.sort(key=lambda x: x[0])\n   188\t    return m\n   189\t\n   190\t\n   191\t# ── Render Functions ─────────────────────────────────────────────────────────\n   192\t\n   193\tdef render_score(m: DayMetrics) -> Text:\n   194\t    s = m.score()\n   195\t    g = m.grade()\n   196\t    color = GRADE_COLORS.get(g, \"white\")\n   197\t\n   198\t    pct = min(s / MAX_SCORE, 1.0)\n   199\t    filled = int(pct * 20)\n   200\t    bar = \"█\" * filled + \"░\" * (20 - filled)\n   201\t\n   202\t    t = Text()\n   203\t    t.append(\"\\n\")\n   204\t    t.append(f\"  {s}\\n\", style=\"bold white\")\n   205\t    t.append(f\"  Grade: \", style=\"dim\")\n   206\t    t.append(f\"{g}\\n\", style=f\"bold {color}\")\n   207\t    t.append(f\"\\n  {bar}\\n\", style=\"cyan\")\n   208\t    t.append(f\"  {int(pct*100)}% of {MAX_SCORE}\\n\\n\", style=\"dim\")\n   209\t    t.append(f\"  ⌨  {m.total_commands} cmds\\n\", style=\"white\")\n   210\t    t.append(f\"  ⏱  {m.active_hours} active hrs\\n\", style=\"white\")\n   211\t    t.append(f\"  📂 {len(m.nvim_files)} files\\n\", style=\"white\")\n   212\t    return t\n   213\t\n   214\t\n   215\tdef render_metrics(m: DayMetrics) -> Table:\n   216\t    table = Table(box=box.SIMPLE, expand=True, padding=(0, 1))\n   217\t    table.add_column(\"Activity\", style=\"bold white\", ratio=3)\n   218\t    table.add_column(\"Count\", justify=\"right\", style=\"cyan\", ratio=1)\n   219\t    table.add_column(\"Points\", justify=\"right\", style=\"green\", ratio=1)\n   220\t\n   221\t    rows = [\n   222\t        (\"Terminals\",    m.windows_opened + m.sessions_opened,\n   223\t         m.windows_opened * WEIGHTS[\"new_window\"] + m.sessions_opened * WEIGHTS[\"new_session\"]),\n   224\t        (\"Nvim opens\",   m.nvim_opens,     m.nvim_opens * WEIGHTS[\"nvim_open\"]),\n   225\t        (\"Unique files\", len(m.nvim_files), len(m.nvim_files) * WEIGHTS[\"nvim_file\"]),\n   226\t        (\"Lazygit\",      m.lazygit_opens,  m.lazygit_opens * WEIGHTS[\"lazygit\"]),\n   227\t        (\"Claude\",       m.claude_opens,   m.claude_opens * WEIGHTS[\"claude\"]),\n   228\t        (\"Commits\",      m.git_commits,    m.git_commits * WEIGHTS[\"git_commit\"]),\n   229\t        (\"Pushes\",       m.git_pushes,     m.git_pushes * WEIGHTS[\"git_push\"]),\n   230\t        (\"Builds\",       m.build_cmds,     m.build_cmds * WEIGHTS[\"build_cmd\"]),\n   231\t        (\"Tests\",        m.test_cmds,      m.test_cmds * WEIGHTS[\"test_cmd\"]),\n   232\t        (\"Docker\",       m.docker_cmds,    m.docker_cmds * WEIGHTS[\"docker_cmd\"]),\n   233\t        (\"SSH\",          m.ssh_cmds,       m.ssh_cmds * WEIGHTS[\"ssh_cmd\"]),\n   234\t        (\"Active hours\", m.active_hours,   m.active_hours * WEIGHTS[\"active_hour\"]),\n   235\t    ]\n   236\t\n   237\t    for name, count, pts in rows:\n   238\t        c = \"—\" if count == 0 else str(count)\n   239\t        p = \"—\" if pts == 0 else f\"+{pts}\"\n   240\t        table.add_row(name, c, p)\n   241\t\n   242\t    return table\n   243\t\n   244\t\n   245\tdef render_heatmap(m: DayMetrics) -> Text:\n   246\t    blocks = \" ░▒▓█\"\n   247\t    colors = [\"dim\", \"dim cyan\", \"cyan\", \"bold cyan\", \"bold white\"]\n   248\t\n   249\t    hours = list(range(6, 23))\n   250\t    counts = [m.commands_by_hour.get(h, 0) for h in hours]\n   251\t    peak = max(counts) if max(counts) > 0 else 1\n   252\t\n   253\t    t = Text()\n   254\t    t.append(\"  \")\n   255\t    for h in hours:\n   256\t        t.append(f\"{h:02d} \", style=\"dim\")\n   257\t    t.append(\"\\n  \")\n   258\t    for c in counts:\n   259\t        level = min(int(c / peak * 4), 4) if c > 0 else 0\n   260\t        t.append(f\" {blocks[level]} \", style=colors[level])\n   261\t    return t\n   262\t\n   263\t\n   264\tdef render_timeline(m: DayMetrics) -> Text:\n   265\t    if not m.timeline:\n   266\t        return Text(\"  No events recorded yet.\", style=\"dim italic\")\n   267\t\n   268\t    t = Text()\n   269\t    for ts, label, detail in reversed(m.timeline):\n   270\t        time_str = datetime.datetime.fromtimestamp(ts).strftime(\"%H:%M:%S\")\n   271\t        detail_trunc = (detail[:50] + \"…\") if len(detail) > 50 else detail\n   272\t        t.append(f\"  {time_str}  \", style=\"dim\")\n   273\t        t.append(f\"{label:<14s}  \", style=\"white\")\n   274\t        t.append(f\"{detail_trunc}\\n\", style=\"dim cyan\")\n   275\t    return t\n   276\t\n   277\t\n   278\t# ── TUI Widgets ──────────────────────────────────────────────────────────────\n   279\t\n   280\tclass TimelinePanel(ScrollableContainer):\n   281\t    def compose(self) -> ComposeResult:\n   282\t        yield Static(\"\", id=\"tl-content\")\n   283\t\n   284\t    def refresh_timeline(self, m: DayMetrics) -> None:\n   285\t        self.query_one(\"#tl-content\", Static).update(render_timeline(m))\n   286\t        self.scroll_home(animate=False)\n   287\t\n   288\t\n   289\t# ── Main App ─────────────────────────────────────────────────────────────────\n   290\t\n   291\tclass ProductivityApp(App):\n   292\t    CSS = \"\"\"\n   293\t    Screen { background: #0d0d0d; }\n   294\t    Header { background: #1a1a2e; }\n   295\t    #top-row { height: 16; margin: 0 1; }\n   296\t    #score-panel { width: 26; border: round #2a2a3e; padding: 0 1; background: #111118; }\n   297\t    #metrics-panel { width: 1fr; border: round #2a2a3e; padding: 0 1; background: #111118; margin-left: 1; }\n   298\t    #heatmap-panel { height: 5; border: round #2a2a3e; padding: 1 1; background: #111118; margin: 1 1 0 1; }\n   299\t    #timeline-panel { height: 1fr; border: round #2a2a3e; background: #0d0d0d; margin: 1; overflow-y: scroll; }\n   300\t    #tl-content { padding: 1 0; }\n   301\t    \"\"\"\n   302\t\n   303\t    BINDINGS = [\n   304\t        Binding(\"q\",     \"quit\",     \"Quit\"),\n   305\t        Binding(\"r\",     \"refresh\",  \"Refresh\"),\n   306\t        Binding(\"left\",  \"prev_day\", \"Prev Day\"),\n   307\t        Binding(\"right\", \"next_day\", \"Next Day\"),\n   308\t        Binding(\"h\",     \"prev_day\", show=False),\n   309\t        Binding(\"l\",     \"next_day\", show=False),\n   310\t    ]\n   311\t\n   312\t    def __init__(self):\n   313\t        super().__init__()\n   314\t        self._date = datetime.date.today()\n   315\t\n   316\t    def compose(self) -> ComposeResult:\n   317\t        yield Header(show_clock=True)\n   318\t        with Horizontal(id=\"top-row\"):\n   319\t            yield Static(\"\", id=\"score-panel\")\n   320\t            yield Static(\"\", id=\"metrics-panel\")\n   321\t        yield Static(\"\", id=\"heatmap-panel\")\n   322\t        yield TimelinePanel(id=\"timeline-panel\")\n   323\t        yield Footer()\n   324\t\n   325\t    def on_mount(self) -> None:\n   326\t        self._load()\n   327\t        self.set_interval(30, self._load)\n   328\t\n   329\t    def _load(self) -> None:\n   330\t        m = parse_log(self._date)\n   331\t\n   332\t        self.title = \"tmux-productivity\"\n   333\t        self.sub_title = f\"{self._date.isoformat()}  •  auto-refresh\"\n   334\t\n   335\t        self.query_one(\"#score-panel\", Static).update(render_score(m))\n   336\t        self.query_one(\"#metrics-panel\", Static).update(render_metrics(m))\n   337\t        self.query_one(\"#heatmap-panel\", Static).update(render_heatmap(m))\n   338\t        self.query_one(\"#timeline-panel\", TimelinePanel).refresh_timeline(m)\n   339\t\n   340\t    def action_refresh(self) -> None:\n   341\t        self._load()\n   342\t\n   343\t    def action_prev_day(self) -> None:\n   344\t        self._date -= datetime.timedelta(days=1)\n   345\t        self._load()\n   346\t\n   347\t    def action_next_day(self) -> None:\n   348\t        if self._date < datetime.date.today():\n   349\t            self._date += datetime.timedelta(days=1)\n   350\t            self._load()\n   351\t\n   352\t\n   353\tif __name__ == \"__main__\":\n   354\t    app = ProductivityApp()\n   355\t    app.run()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
